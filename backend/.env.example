# ==============================================================================
# Environment Configuration Template for Jeff G. Wilson Portfolio Backend
# ==============================================================================

PROJECT_NAME="Jeff G. Wilson Portfolio API"
API_V1_STR="/api"
SECRET_KEY="generate_a_secure_jwt_secret_key_here_for_production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM="HS256"

# Database Configuration (PostgreSQL in production, SQLite for local testing)
DATABASE_URL="postgresql://username:password@localhost:5432/portfolio_db"
# Local SQLite fallback: DATABASE_URL="sqlite:///./portfolio.db"

# Allowed CORS Origins (JSON list of URL strings)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# File Storage Configuration
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=25
BASE_URL="http://127.0.0.1:8000"

# Initial Superuser Seed Credentials
FIRST_SUPERUSER_EMAIL="admin@example.com"
FIRST_SUPERUSER_PASSWORD="ChangeMeInProduction123!"
